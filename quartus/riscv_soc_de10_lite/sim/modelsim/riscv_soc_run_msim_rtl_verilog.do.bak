transcript on
if {[file exists rtl_work]} {
	vdel -lib rtl_work -all
}
vlib rtl_work
vmap work rtl_work

vlog -vlog01compat -work work +incdir+C:/FPGA/riscv_soc_de10_lite/rtl/core {C:/FPGA/riscv_soc_de10_lite/rtl/core/rv32_alu.v}

vlog -vlog01compat -work work +incdir+C:/FPGA/riscv_soc_de10_lite/quartus/../tb/core {C:/FPGA/riscv_soc_de10_lite/quartus/../tb/core/tb_rv32_alu.v}

vsim -t 1ps -L altera_ver -L lpm_ver -L sgate_ver -L altera_mf_ver -L altera_lnsim_ver -L fiftyfivenm_ver -L rtl_work -L work -voptargs="+acc"  tb_rv32_alu

add wave *
view structure
view signals
run -all
