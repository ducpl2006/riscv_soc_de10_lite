transcript on
if {[file exists rtl_work]} {
	vdel -lib rtl_work -all
}
vlib rtl_work
vmap work rtl_work

vlog -vlog01compat -work work +incdir+C:/FPGA/riscv_soc_de10_lite/rtl/core {C:/FPGA/riscv_soc_de10_lite/rtl/core/rv32_branch_unit.v}
